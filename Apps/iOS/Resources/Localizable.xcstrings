            "value" : "Café"
          }
        }
      }
    },
    "New measurement" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelle mesure"
          }
        }
      }
    },
    "Home, office, café…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maison, bureau, café…"
          }
        }
      }
    },
    "Where are you?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où es-tu ?"
          }
        }
      }
    },
    "Name it after the place, to find it among your measurements." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne-lui le nom du lieu, pour la retrouver parmi tes mesures."
          }
        }
      }
    },
    "Lay your iPhone next to your Mac and leave both still for 20 seconds." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose ton iPhone à côté de ton Mac et laisse-les immobiles pendant 20 secondes."
          }
        }
      }
    },
    "Meanwhile, the Wi-Fi of your Mac may pause for a moment and Bluetooth headphones may stutter. Locky neither locks nor unlocks until it is over." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant ce temps, le Wi-Fi de ton Mac peut marquer de courtes pauses et le son des écouteurs Bluetooth peut hoqueter. Locky ne verrouille ni ne déverrouille avant la fin."
          }
        }
      }
    },
    "Measuring “%@”" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure de « %@ »"
          }
        }
      }
    },
    "Saving “%@”" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrement de « %@ »"
          }
        }
      }
    },
    "Leave your iPhone next to your Mac. Locky neither locks nor unlocks meanwhile." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse ton iPhone à côté de ton Mac. Locky ne verrouille ni ne déverrouille pendant ce temps."
          }
        }
      }
    },
    "Both parts of the measurement go to iCloud, sealed with the key of your pairing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux parts de la mesure partent dans iCloud, scellées avec la clé de ton appairage."
          }
        }
      }
    },
    "Your Mac does not take part: what only it hears will be missing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac ne participe pas : il manquera ce que lui seul entend."
          }
        }
      }
    },
    "Bluetooth" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth"
          }
        }
      }
    },
    "Magnetism" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnétisme"
          }
        }
      }
    },
    "Link" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lien"
          }
        }
      }
    },
    "Pair your iPhone with your Mac first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence par appairer ton iPhone avec ton Mac."
          }
        }
      }
    },
    "Your Mac is out of reach: get next to it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac est hors de portée : rapproche-toi de lui."
          }
        }
      }
    },
    "Update Locky on your Mac to measure the waves." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets à jour Locky sur ton Mac pour mesurer les ondes."
          }
        }
      }
    },
    "Open Locky on your iPhone: it listens only while it is on screen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Locky sur ton iPhone : il n’écoute que lorsqu’il est à l’écran."
          }
        }
      }
    },
    "Calm" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calme"
          }
        }
      }
    },
    "Busy" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animé"
          }
        }
      }
    },
    "Crowded" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chargé"
          }
        }
      }
    },
    "Nothing gets in the way: Locky measures the distance precisely here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
