      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage"
          }
        }
      }
    },
    "Take your iPhone with you, in your hand or in your pocket. Beyond %@, Locky locks your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre iPhone avec vous, en main ou dans la poche. Au-delà de %@, Locky verrouille votre Mac."
