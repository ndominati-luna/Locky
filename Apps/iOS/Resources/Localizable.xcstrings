          }
        }
      }
    },
    "Sign in to iCloud on your iPhone and your Mac with the same Apple Account to receive break-in reports." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à iCloud sur votre iPhone et votre Mac avec le même compte Apple pour recevoir les rapports d’intrusion."
