          }
        }
      }
    },
    "You found it! %lld taps, one for every year since the very first Locky." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien vu ! %lld taps, un par année depuis le tout premier Locky."
          }
        }
      }
    },
    "Your Mac is out of reach: it will receive the change through iCloud." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac est hors de portée : il recevra le changement via iCloud."
          }
        }
      }
    },
    "Your Mac locks at once. The wings still appear on the lock screen when your iPhone is near." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac se verrouille aussitôt. Les ailes apparaissent quand même sur l’écran de verrouillage quand ton iPhone est proche."
          }
        }
      }
    },
    "Your Mac looks for a new version and shows you the answer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac cherche une nouvelle version et t’affiche la réponse."
          }
        }
      }
    },
    "Your Mac must be in reach to change it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac doit être à portée pour le modifier."
