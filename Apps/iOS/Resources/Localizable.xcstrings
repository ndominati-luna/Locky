        }
      }
    },
    "Someone just tried to unlock your Mac!" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un vient juste d’essayer de déverrouiller votre Mac !"
