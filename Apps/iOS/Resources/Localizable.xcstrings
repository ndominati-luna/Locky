    },
    "Locky does not know your Mac password yet. Use \"Update session password\" in the Locky menu on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky ne connaît pas encore le mot de passe de ton Mac. Utilise « Mettre à jour le mot de passe de session » dans le menu Locky de ton Mac."
          }
        }
      }
    },
    "Locky is set to unlock your Mac only from your Apple Watch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky est réglé pour ne déverrouiller ton Mac que depuis ton Apple Watch."
          }
        }
      }
    },
    "Locky locked your Mac when you walked away and unlocked it when you came back. It now works on its own, even with your iPhone in your pocket." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky a verrouillé ton Mac pendant ton absence et l’a déverrouillé à ton retour. Il fonctionne désormais tout seul, même avec ton iPhone dans la poche."
          }
        }
      }
    },
    "Locky locks your Mac when you walk away with your iPhone and unlocks it when you come back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky verrouille ton Mac quand tu t’éloignes avec ton iPhone et le déverrouille à ton retour."
          }
        }
      }
    },
    "Locky needs Bluetooth access to reach your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky a besoin du Bluetooth pour joindre ton Mac."
          }
        }
      }
    },
    "Locky needs your macOS session password to unlock your Mac. It is verified on your Mac, then stored only in the keychain of this iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky a besoin du mot de passe de ta session macOS pour déverrouiller ton Mac. Il est vérifié sur ton Mac, puis conservé uniquement dans le trousseau de cet iPhone."
          }
        }
      }
    },
    "Locky on your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky sur ton Mac"
          }
        }
      }
    },
    "Locky on your Mac will send you a photo if someone tries to unlock it while you're not there. Photos are stored in your iCloud account." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky sur ton Mac t’enverra une photo si quelqu’un essaie de le déverrouiller en ton absence. Les photos sont stockées dans ton compte iCloud."
          }
        }
      }
    },
    "Locky will ask for %@ before unlocking your Mac from your iPhone or from the lock screen of your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky te demandera %@ avant de déverrouiller ton Mac depuis ton iPhone ou depuis l’écran de verrouillage de ton Mac."
          }
        }
      }
    },
    "Locky will ask you to authenticate before unlocking your Mac from your iPhone or from the lock screen of your Mac." : {
