    "Locky" : {
      "shouldTranslate" : false
    },
    "Locky could not save the pairing. Please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky n’a pas pu enregistrer l’appairage. Veuillez réessayer."
          }
        }
      }
    },
    "Locky does not know your Mac password yet. Use \"Update session password\" in the Locky menu on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky ne connaît pas encore le mot de passe de votre Mac. Utilisez « Mettre à jour le mot de passe de session » dans le menu Locky de votre Mac."
          }
        }
      }
    },
    "Locky is set to unlock your Mac only from your Apple Watch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky est réglé pour ne déverrouiller votre Mac que depuis votre Apple Watch."
          }
        }
      }
    },
    "Locky locked your Mac when you walked away and unlocked it when you came back. It now works on its own, even with your iPhone in your pocket." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky a verrouillé votre Mac pendant votre absence et l'a déverrouillé à votre retour. Il fonctionne désormais tout seul, même avec votre iPhone dans la poche."
          }
        }
      }
    },
    "Locky locks your Mac when you walk away with your iPhone and unlocks it when you come back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky verrouille votre Mac quand vous vous éloignez avec votre iPhone et le déverrouille à votre retour."
          }
        }
      }
    },
    "Locky needs Bluetooth access to reach your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky a besoin du Bluetooth pour joindre votre Mac."
          }
        }
      }
    },
    "Locky needs your macOS session password to unlock your Mac. It is verified on your Mac, then stored only in the keychain of this iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky a besoin du mot de passe de votre session macOS pour déverrouiller votre Mac. Il est vérifié sur votre Mac, puis conservé uniquement dans le trousseau de cet iPhone."
          }
        }
      }
    },
    "Locky on your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky sur votre Mac"
          }
        }
      }
    },
    "Locky on your Mac will send you a photo if someone tries to unlock it while you're not there. Photos are stored in your iCloud account." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky sur votre Mac vous enverra une photo si quelqu’un essaie de le déverrouiller en votre absence. Les photos sont stockées dans votre compte iCloud."
          }
        }
      }
    },
    "Locky will ask for %@ before unlocking your Mac from your iPhone or from the lock screen of your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky vous demandera %@ avant de déverrouiller votre Mac depuis votre iPhone ou depuis l’écran de verrouillage de votre Mac."
          }
        }
      }
    },
    "Locky will ask you to authenticate before unlocking your Mac from your iPhone or from the lock screen of your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky vous demandera de vous authentifier avant de déverrouiller votre Mac depuis votre iPhone ou depuis l’écran de verrouillage de votre Mac."
          }
        }
      }
    },
    "Locky will automatically enter your password to unlock your Mac when you're close to it with your iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky entrera automatiquement votre mot de passe pour déverrouiller votre Mac lorsque vous êtes près de lui avec votre iPhone."
          }
        }
      }
    },
    "Locky will send you notifications when your Mac is locked or unlocked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky vous enverra des notifications quand votre Mac est verrouillé ou déverrouillé."
          }
        }
      }
    },
    "Locky will stop locking and unlocking this Mac. You can pair it again at any time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky ne verrouillera et ne déverrouillera plus ce Mac. Vous pourrez l’appairer à nouveau à tout moment."
          }
        }
      }
    },
    "Looking for your Mac…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de votre Mac…"
          }
        }
      }
    },
