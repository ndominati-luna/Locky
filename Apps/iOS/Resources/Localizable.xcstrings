    },
    "Walk away with your iPhone: your Mac will lock. Come back: it will unlock." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éloignez-vous avec votre iPhone : votre Mac se verrouille. Revenez : il se déverrouille."
