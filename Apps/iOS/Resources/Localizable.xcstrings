    "Thermal state of your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "État thermique de votre Mac"
          }
        }
      }
    },
    "To work properly, Locky needs permissions to use Bluetooth and notifications. Your Mac password stays in the keychain of your iPhone and only travels end-to-end encrypted to your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour fonctionner correctement, Locky doit avoir les permissions d’utiliser le Bluetooth et d’envoyer des notifications. Le mot de passe de votre Mac reste dans le trousseau de votre iPhone et ne voyage que chiffré de bout en bout vers votre Mac."
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui"
          }
        }
      }
    },
