        }
      }
    },
    "Your Mac will receive the change when it is back in reach." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac recevra le changement dès qu’il sera de nouveau à portée."
