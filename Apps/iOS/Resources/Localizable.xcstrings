            "value" : "Active le Bluetooth pour que Locky puisse joindre ton Mac."
          }
        }
      }
    },
    "Turn on intruder detection" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer la détection des intrus"
