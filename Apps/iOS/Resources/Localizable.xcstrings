            "value" : "Bluetooth classique"
          }
        }
      }
    },
    "No Wi-Fi network heard: the Wi-Fi of your Mac may be off." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun réseau Wi-Fi entendu : le Wi-Fi de ton Mac est peut-être coupé."
          }
        }
      }
    },
    "Dotted lines: where Bluetooth advertises, and Locky looks for your iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pointillés : là où le Bluetooth s’annonce, et où Locky cherche ton iPhone."
