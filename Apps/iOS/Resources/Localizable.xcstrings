    },
    "Your body and clothes reduce the signal strength, and therefore impact the calculated distance between your Mac and iPhone. You can adjust the lock distance at any time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton corps et tes vêtements atténuent le signal, et donc la distance calculée entre ton Mac et ton iPhone. Tu peux ajuster la distance de verrouillage à tout moment."
          }
        }
      }
    },
    "Your iPhone is about %@ from your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone est à environ %@ de ton Mac."
          }
        }
      }
    },
    "Your iPhone is paired with %@. Allow Locky on your Mac, then click “Try it now”: walk away, come back, and watch the magic happen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone est appairé avec %@. Autorise Locky sur ton Mac, puis clique sur « Essayer maintenant » : éloigne-toi, reviens, et la magie opère."
          }
        }
      }
    },
    "Your Mac" : {
