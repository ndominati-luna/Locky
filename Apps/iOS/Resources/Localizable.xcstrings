    "Locky is designed and built by Lunabee Studio." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky est conçue et développée par Lunabee Studio."
          }
        }
      }
    },
    "Locky is reborn in Swift, from the iPhone to the Mac and the Apple Watch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky renaît en Swift, de l’iPhone au Mac en passant par l’Apple Watch."
          }
        }
      }
    },
    "Locky locks your Mac when you walk away with your iPhone. Same as “Locky activated” in the Locky menu on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky verrouille ton Mac quand tu t’éloignes avec ton iPhone. C’est le même réglage que « Locky activé » dans le menu Locky de ton Mac."
          }
        }
      }
    },
