    "Version %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@"
          }
        }
      }
    },
    "Volume of your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume de ton Mac"
          }
        }
      }
    },
    "Waiting for your Mac…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de ton Mac…"
          }
        }
      }
    },
    "Walk away from your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éloigne-toi de ton Mac"
          }
        }
      }
    },
    "Walk away with your iPhone: your Mac will lock. Come back: it will unlock." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éloigne-toi avec ton iPhone : ton Mac se verrouille. Reviens : il se déverrouille."
          }
        }
      }
    },
    "Walk away, it locks" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pars, il se verrouille"
          }
        }
      }
    },
    "Warm" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiède"
          }
        }
      }
    },
    "Welcome" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue"
          }
        }
      }
    },
    "When intruder detection is on, your Mac takes a photo of anyone trying to use it while you're away and sends it here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la détection des intrus est activée, ton Mac photographie toute personne qui essaie de l’utiliser en ton absence et t’envoie la photo ici."
          }
        }
      }
    },
    "When you're away with your iPhone, Locky can send you a photo of the intruder when activity is detected on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu es loin avec ton iPhone, Locky peut t’envoyer une photo de l’intrus si une activité est détectée sur ton Mac."
          }
        }
      }
    },
    "Yesterday" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier"
          }
        }
      }
    },
    "Your body and clothes reduce the signal strength, and therefore impact the calculated distance between your Mac and iPhone. You can adjust the lock distance at any time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton corps et tes vêtements atténuent le signal, et donc la distance calculée entre ton Mac et ton iPhone. Tu peux ajuster la distance de verrouillage à tout moment."
          }
        }
      }
    },
    "Your iPhone is about %@ from your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone est à environ %@ de ton Mac."
          }
        }
      }
    },
    "Your iPhone is paired with %@. Allow Locky on your Mac, then click “Try it now”: walk away, come back, and watch the magic happen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone est appairé avec %@. Autorise Locky sur ton Mac, puis clique sur « Essayer maintenant » : éloigne-toi, reviens, et la magie opère."
          }
        }
      }
    },
    "Your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac"
          }
        }
      }
    },
    "Your Mac can only be unlocked from your Apple Watch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac ne peut être déverrouillé que depuis ton Apple Watch."
          }
        }
      }
    },
    "Your Mac is locked" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac est verrouillé"
          }
        }
      }
    },
    "Your Mac is locked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac est verrouillé."
          }
        }
      }
    },
    "Your Mac is not connected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac n’est pas connecté."
          }
        }
      }
    },
    "Your Mac is running hot" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac chauffe"
          }
        }
      }
    },
    "Your Mac is unlocked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac est déverrouillé."
          }
        }
      }
    },
    "Your Mac refused the password. If you changed it, choose \"Update session password\" in the Locky menu on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac a refusé le mot de passe. Si tu l’as changé, choisis « Mettre à jour le mot de passe de session » dans le menu Locky de ton Mac."
          }
        }
      }
    },
    "Your Mac will only be unlocked from the Locky app on your Apple Watch. Locking still works everywhere." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac ne pourra être déverrouillé que depuis l’app Locky de ton Apple Watch. Le verrouillage fonctionne toujours partout."
          }
        }
      }
    },
    "Calibrate the distance" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrer la distance"
          }
        }
      }
    },
    "Measuring…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure en cours…"
          }
        }
      }
    },
    "Distance calibrated" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance calibrée"
          }
        }
      }
    },
    "Calibration failed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec du calibrage"
          }
        }
      }
    },
    "Your iPhone must be connected to your Mac to calibrate the distance." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone doit être connecté à ton Mac pour calibrer la distance."
          }
        }
      }
    },
    "Stay still, it only takes a few seconds." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bouge plus, ça ne prend que quelques secondes."
          }
        }
      }
    },
    "Locky now measures the distance from your iPhone to your Mac with this new reference." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky mesure désormais la distance entre ton iPhone et ton Mac avec cette nouvelle référence."
          }
        }
      }
    },
    "Check that your iPhone is connected to your Mac and try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie que ton iPhone est connecté à ton Mac, puis réessaie."
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer"
          }
        }
      }
    },
    "Live Activity" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activité en direct"
          }
        }
      }
    },
    "The distance to your Mac and its state on the Lock Screen and in the Dynamic Island, with the Locky button. iOS ends it after 8 hours: it starts again when you open Locky." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distance à ton Mac et son état sur l’écran verrouillé et dans la Dynamic Island, avec le bouton Locky. iOS l’arrête au bout de 8 heures : elle reprend dès que tu ouvres Locky."
          }
        }
      }
    },
    "Live Activities are turned off for Locky in the Settings app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités en direct sont désactivées pour Locky dans l’app Réglages."
          }
        }
      }
    },
    "Stand about 1 m from your Mac (a big step), your back to it, your iPhone in your hand in front of you: you are between them, as when you walk away. Confirm, then stay still during the measure." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place-toi à environ 1 m de ton Mac (un grand pas), dos à lui, ton iPhone en main devant toi : tu es entre les deux, comme quand tu pars. Valide, puis ne bouge plus pendant la mesure."
          }
        }
      }
    },
    "Confirm" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valider"
          }
        }
      }
    },
    "Don't move for a few seconds." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bouge plus pendant quelques secondes."
          }
        }
      }
    },
    "Stand 1 m from your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place-toi à 1 m de ton Mac"
          }
        }
      }
    },
    "Stand about 1 m from your Mac (a big step), your back to it, your iPhone in your hand in front of you: you are between them, as when you walk away. Confirm, then stay still. Locky measures the signal there, then at 2 m, to know the distance." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place-toi à environ 1 m de ton Mac (un grand pas), dos à lui, ton iPhone en main devant toi : tu es entre les deux, comme quand tu pars. Valide, puis ne bouge plus. Locky mesure le signal ici, puis à 2 m, pour connaître la distance."
          }
        }
      }
    },
    "Step 1 of 2" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étape 1 sur 2"
          }
        }
      }
    },
    "Step 2 of 2" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étape 2 sur 2"
          }
        }
      }
    },
    "Step back to 2 m" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recule à 2 m"
          }
        }
      }
    },
    "Now step back to about 2 m from your Mac (two big steps), still with your back to it and your iPhone in front of you, then confirm." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recule maintenant à environ 2 m de ton Mac (deux grands pas), toujours dos à lui et ton iPhone devant toi, puis valide."
          }
        }
      }
    },
    "Your Mac is out of reach" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac est hors de portée"
          }
        }
      }
    },
    "Your iPhone and your Mac are checking each other." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone et ton Mac se vérifient l’un l’autre."
          }
        }
      }
    },
    "Locky is not allowed to use the camera of your Mac: intruders won't be photographed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky n’a pas accès à la caméra de ton Mac : les intrus ne seront pas photographiés."
          }
        }
      }
    },
    "Your Mac has not let Locky use its camera yet: intruders won't be photographed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac n’a pas encore donné accès à sa caméra à Locky : les intrus ne seront pas photographiés."
          }
        }
      }
    },
    "Your Mac has no camera: break-in attempts will be reported without a photo." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac n’a pas de caméra : les tentatives d’intrusion seront signalées sans photo."
          }
        }
      }
    },
    "Allow on my Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser sur mon Mac"
          }
        }
      }
    },
    "Ask on my Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander sur mon Mac"
          }
        }
      }
    },
    "Unlock your Mac to continue there." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouille ton Mac pour continuer dessus."
          }
        }
      }
    },
    "Continue on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue sur ton Mac."
          }
        }
      }
    },
    "Your Mac must be connected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac doit être connecté."
          }
        }
      }
    }
