    "Warm" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiède"
          }
        }
      }
    },
    "Welcome" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue"
          }
        }
      }
    },
    "When intruder detection is on, your Mac takes a photo of anyone trying to use it while you're away and sends it here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la détection des intrus est activée, votre Mac photographie toute personne qui essaie de l’utiliser en votre absence et vous envoie la photo ici."
          }
        }
      }
    },
    "When you're away with your iPhone, Locky can send you a photo of the intruder when activity is detected on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous êtes loin avec votre iPhone, Locky peut vous envoyer une photo de l’intrus si une activité est détectée sur votre Mac."
          }
        }
      }
    },
    "Yesterday" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier"
          }
        }
      }
    },
    "Your body and clothes reduce the signal strength, and therefore impact the calculated distance between your Mac and iPhone. You can adjust the lock distance at any time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre corps et vos vêtements atténuent le signal, et donc la distance calculée entre votre Mac et votre iPhone. Vous pouvez ajuster la distance de verrouillage à tout moment."
          }
        }
      }
    },
    "Your iPhone is about %@ from your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone est à environ %@ de votre Mac."
          }
        }
      }
    },
    "Your iPhone is paired with %@. Allow Locky on your Mac, then click “Try it now”: walk away, come back, and watch the magic happen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone est appairé avec %@. Autorisez Locky sur votre Mac, puis cliquez sur « Essayer maintenant » : éloignez-vous, revenez, et la magie opère."
          }
        }
      }
    },
    "Your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac"
          }
        }
      }
    },
    "Your Mac can only be unlocked from your Apple Watch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac ne peut être déverrouillé que depuis votre Apple Watch."
          }
        }
      }
    },
    "Your Mac is locked" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac est verrouillé"
          }
        }
      }
    },
    "Your Mac is locked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac est verrouillé."
          }
        }
      }
    },
    "Your Mac is not connected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac n’est pas connecté."
          }
        }
      }
    },
    "Your Mac is running hot" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac chauffe"
          }
        }
      }
    },
    "Your Mac is unlocked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac est déverrouillé."
          }
        }
      }
    },
    "Your Mac refused the password. If you changed it, choose \"Update session password\" in the Locky menu on your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac a refusé le mot de passe. Si vous l’avez changé, choisissez « Mettre à jour le mot de passe de session » dans le menu Locky de votre Mac."
          }
        }
      }
    },
    "Your Mac will only be unlocked from the Locky app on your Apple Watch. Locking still works everywhere." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac ne pourra être déverrouillé que depuis l’app Locky de votre Apple Watch. Le verrouillage fonctionne toujours partout."
          }
        }
      }
    },
    "Calibrate the distance" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrer la distance"
          }
        }
      }
    },
    "Measuring…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure en cours…"
          }
        }
      }
    },
    "Distance calibrated" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance calibrée"
          }
        }
      }
    },
    "Calibration failed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec du calibrage"
          }
        }
      }
    },
    "Your iPhone must be connected to your Mac to calibrate the distance." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone doit être connecté à votre Mac pour calibrer la distance."
          }
        }
      }
    },
    "Stay still, it only takes a few seconds." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bougez plus, cela ne prend que quelques secondes."
          }
        }
      }
    },
    "Locky now measures the distance from your iPhone to your Mac with this new reference." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky mesure désormais la distance entre votre iPhone et votre Mac avec cette nouvelle référence."
          }
        }
      }
    },
    "Check that your iPhone is connected to your Mac and try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que votre iPhone est connecté à votre Mac, puis réessayez."
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer"
          }
        }
      }
    },
    "Live Activity" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activité en direct"
          }
        }
      }
    },
    "The distance to your Mac and its state on the Lock Screen and in the Dynamic Island, with the Locky button. iOS ends it after 8 hours: it starts again when you open Locky." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distance à votre Mac et son état sur l’écran verrouillé et dans la Dynamic Island, avec le bouton Locky. iOS l’arrête au bout de 8 heures : elle reprend dès que vous ouvrez Locky."
          }
        }
      }
    },
    "Live Activities are turned off for Locky in the Settings app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités en direct sont désactivées pour Locky dans l’app Réglages."
          }
        }
      }
    },
    "Stand about 1 m from your Mac (a big step), your back to it, your iPhone in your hand in front of you: you are between them, as when you walk away. Confirm, then stay still during the measure." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez-vous à environ 1 m de votre Mac (un grand pas), dos à lui, votre iPhone en main devant vous : vous êtes entre les deux, comme quand vous partez. Validez, puis ne bougez plus pendant la mesure."
          }
        }
      }
    },
    "Confirm" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valider"
          }
        }
      }
    },
    "Don't move for a few seconds." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bougez plus pendant quelques secondes."
          }
        }
      }
    },
    "Stand 1 m from your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez-vous à 1 m de votre Mac"
          }
        }
      }
    },
    "Stand about 1 m from your Mac (a big step), your back to it, your iPhone in your hand in front of you: you are between them, as when you walk away. Confirm, then stay still. Locky measures the signal there, then at 2 m, to know the distance." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez-vous à environ 1 m de votre Mac (un grand pas), dos à lui, votre iPhone en main devant vous : vous êtes entre les deux, comme quand vous partez. Validez, puis ne bougez plus. Locky mesure le signal ici, puis à 2 m, pour connaître la distance."
          }
        }
      }
    },
    "Step 1 of 2" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étape 1 sur 2"
          }
        }
      }
    },
    "Step 2 of 2" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étape 2 sur 2"
          }
        }
      }
    },
    "Step back to 2 m" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reculez à 2 m"
          }
        }
      }
    },
    "Now step back to about 2 m from your Mac (two big steps), still with your back to it and your iPhone in front of you, then confirm." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reculez maintenant à environ 2 m de votre Mac (deux grands pas), toujours dos à lui et votre iPhone devant vous, puis validez."
          }
        }
      }
    },
    "Your Mac is out of reach" : {
      "localizations" : {
        "fr" : {
