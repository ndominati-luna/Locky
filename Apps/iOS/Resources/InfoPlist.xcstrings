    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky uses Bluetooth to stay connected to your Mac and to measure the distance between your iPhone and your Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locky utilise le Bluetooth pour rester connecté à ton Mac et mesurer la distance entre ton iPhone et ton Mac."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky only uses the camera when you take a picture for the wallpaper of a Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky n’utilise l’appareil photo que lorsque tu prends une photo pour le fond d’écran d’un Mac."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky can ask for Face ID before unlocking your Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locky peut demander Face ID avant de déverrouiller ton Mac."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky only locks your Mac when your iPhone is moving away from it, not when the signal fluctuates while you sit at your desk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locky ne verrouille ton Mac que lorsque ton iPhone s’en éloigne, pas quand le signal fluctue pendant que tu es à ton bureau."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you measure the waves around your Mac, Locky listens to the sound around for 20 seconds to show its spectrum. Nothing is recorded."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu mesures les ondes autour de ton Mac, Locky écoute le son ambiant pendant 20 secondes pour en montrer le spectre. Rien n’est enregistré."
          }
        }
      }
    }
  },
  "version" : "1.0"
}