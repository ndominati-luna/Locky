    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky shows on your iPhone what Music or Spotify is playing on your Mac, so you can control it from there."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locky affiche sur votre iPhone ce que Musique ou Spotify joue sur votre Mac, pour que vous puissiez le contrôler de là."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky uses Bluetooth to talk to your iPhone and measure how far it is from your Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locky utilise le Bluetooth pour communiquer avec votre iPhone et mesurer sa distance avec votre Mac."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When intruder detection is on, Locky takes a photo of people trying to use your Mac while you are away."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quand la détection des intrus est activée, Locky photographie les personnes qui essaient d’utiliser votre Mac en votre absence."
          }
        }
      }
    },
