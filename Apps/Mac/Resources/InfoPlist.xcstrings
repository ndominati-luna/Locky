    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky shows on your iPhone what Music or Spotify is playing on your Mac, so you can control it from there."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locky affiche sur ton iPhone ce que Musique ou Spotify joue sur ton Mac, pour que tu puisses le contrôler de là."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locky uses Bluetooth to talk to your iPhone and measure how far it is from your Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locky utilise le Bluetooth pour communiquer avec ton iPhone et mesurer sa distance avec ton Mac."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When intruder detection is on, Locky takes a photo of people trying to use your Mac while you are away."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quand la détection des intrus est activée, Locky photographie les personnes qui essaient d’utiliser ton Mac en ton absence."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "© Lunabee Studio"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you measure the waves around your Mac, macOS shows Locky the names of the Wi-Fi networks only if it may use Location Services. Locky never reads where you are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu mesures les ondes autour de ton Mac, macOS ne montre le nom des réseaux Wi-Fi à Locky que s’il peut utiliser le Service de localisation. Locky ne lit jamais où tu te trouves."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you measure the waves around your Mac, macOS shows Locky the names of the Wi-Fi networks only if it may use Location Services. Locky never reads where you are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu mesures les ondes autour de ton Mac, macOS ne montre le nom des réseaux Wi-Fi à Locky que s’il peut utiliser le Service de localisation. Locky ne lit jamais où tu te trouves."
          }
        }
      }
    }
  },
  "version" : "1.0"
