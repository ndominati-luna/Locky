    "Locky arrives on the Apple Watch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky arrive sur l’Apple Watch."
          }
        }
      }
    },
    "Locky can't read this image." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky ne peut pas lire cette image."
          }
        }
      }
    },
    "Locky can't unlock your Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky ne peut pas déverrouiller ton Mac"
          }
        }
      }
    },
    "Locky comes out: walk away, and your Mac locks itself." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky sort : tu t’éloignes, et ton Mac se verrouille tout seul."
          }
        }
      }
    },
    "Locky could not save the pairing in the keychain." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky n’a pas pu enregistrer l’appairage dans le trousseau."
          }
        }
      }
    },
    "Locky for Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky pour Mac"
          }
        }
      }
    },
    "Locky is designed and built by Lunabee Studio." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky est conçue et développée par Lunabee Studio."
          }
        }
      }
    },
    "Locky is reborn in Swift, from the iPhone to the Mac and the Apple Watch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky renaît en Swift, de l’iPhone au Mac en passant par l’Apple Watch."
          }
        }
      }
    },
    "Locky locked your Mac when you walked away and unlocked it when you came back. From now on, it watches over your Mac from the menu bar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky a verrouillé ton Mac pendant ton absence et l’a déverrouillé à ton retour. Désormais, il veille sur ton Mac depuis la barre des menus."
          }
        }
      }
    },
    "Locky locks your Mac when you walk away with your iPhone and unlocks it when you come back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky verrouille ton Mac quand tu t’éloignes avec ton iPhone et le déverrouille à ton retour."
          }
        }
      }
    },
    "Locky not connected" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky non connecté"
          }
        }
      }
    },
    "Locky types it on the lock screen to unlock your Mac. It is checked here, then kept only in the keychain of %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky le saisit sur l’écran de verrouillage pour déverrouiller ton Mac. Il est vérifié ici, puis conservé uniquement dans le trousseau de %@."
          }
        }
      }
    },
    "Locky will be available in your Mac's top bar. A few permissions make it work at its best:" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky sera disponible dans la barre des menus de ton Mac. Quelques autorisations lui permettent de fonctionner au mieux :"
          }
        }
      }
    },
    "Locky will stop locking and unlocking this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky ne verrouillera et ne déverrouillera plus ce Mac."
          }
        }
      }
    },
    "Looking for Locky iPhones…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche d’iPhone avec Locky…"
          }
        }
      }
    },
    "Low battery level on %@!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterie faible sur %@ !"
