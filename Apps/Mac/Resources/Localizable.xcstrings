            "value" : "Champ magnétique"
          }
        }
      }
    },
    "Locky estimates the distance from the strength of the Bluetooth signal of your iPhone. Here is what blurs it where you measured." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky estime la distance d’après la force du signal Bluetooth de ton iPhone. Voici ce qui le brouille là où tu as mesuré."
          }
        }
      }
    },
    "Heard by" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendus par"
          }
        }
      }
    },
    "Mac" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac"
          }
        }
      }
    },
    "Classic" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classique"
          }
        }
      }
    },
    "Bluetooth Low Energy: watches, headphones, trackers, phones… Many change their address every few minutes, so one device may show up twice." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth basse consommation : montres, écouteurs, balises, téléphones… Beaucoup changent d’adresse toutes les quelques minutes : un même appareil peut apparaître deux fois."
          }
        }
      }
    },
    "Classic Bluetooth: speakers, headphones, cars, keyboards… Connected ones share the Bluetooth radio of your Mac with Locky." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth classique : enceintes, casques, voitures, claviers… Ceux qui sont connectés partagent la radio Bluetooth de ton Mac avec Locky."
          }
        }
      }
    },
    "No device heard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
