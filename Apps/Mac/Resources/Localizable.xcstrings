    "The codes match" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes correspondent"
          }
        }
      }
    },
    "The connection with the iPhone was lost. Keep both devices close and try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion avec l’iPhone a été perdue. Garde les deux appareils proches et réessaie."
          }
        }
      }
    },
    "The desktop fades into its wallpaper, then an iris closes on the Locky logo." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bureau s’efface dans son fond d’écran, puis un iris se referme sur le logo Locky."
          }
        }
      }
    },
    "The first lines of Locky, for the iPhone and the Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les premières lignes de Locky, pour l’iPhone et le Mac."
          }
        }
      }
    },
    "The iPhone and the Mac now talk in encrypted messages, and Locky starts by itself when you log in." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPhone et le Mac se parlent désormais en messages chiffrés, et Locky démarre tout seul quand tu ouvres ta session."
          }
        }
      }
    },
    "The key of the iPhone is invalid. Please try again." : {
