    "Watch again" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoir le film"
          }
        }
      }
    },
    "Welcome to Locky" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans Locky"
          }
        }
      }
    },
    "You found it! %lld clicks, one for every year since the very first Locky." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien vu ! %lld clics, un par année depuis le tout premier Locky."
          }
        }
      }
    },
    "You're all set" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est prêt"
          }
        }
      }
    },
    "Your iPhone is not connected to Locky." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone n’est pas connecté à Locky."
          }
        }
      }
    },
    "Your iPhone must be connected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton iPhone doit être connecté."
          }
        }
      }
    },
    "Your iPhone's battery is only %lld%% full. Charge it if you want to have Locky working." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batterie de ton iPhone n’est chargée qu’à %lld %%. Recharge-le pour que Locky continue de fonctionner."
          }
        }
      }
    },
    "Your Mac locks at once. The wings still appear on the lock screen when your iPhone is near." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mac se verrouille aussitôt. Les ailes apparaissent quand même sur l’écran de verrouillage quand ton iPhone est proche."
          }
        }
      }
    },
    "Your session password" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton mot de passe de session"
          }
        }
      }
    },
    "“Unlock with Locky” on the lock screen" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Déverrouiller avec Locky » sur l’écran de verrouillage"
          }
        }
      }
    },
    "Put your iPhone about 1 m from your Mac, then 2 m, confirming each time on your iPhone.\nPlease don't touch it during the measures." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose ton iPhone à environ 1 m de ton Mac, puis à 2 m, en validant à chaque fois sur l’iPhone.\nN’y touche pas pendant les mesures."
          }
        }
      }
    },
    "Intruders detection is now activated. This Mac has no camera: attempts will be reported without a photo." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détection des intrus est activée. Ce Mac n’a pas de caméra : les tentatives seront signalées sans photo."
          }
        }
      }
    },
    "Locky can't use the camera: intruders won't be photographed. Click to allow it in System Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locky ne peut pas utiliser la caméra : les intrus ne seront pas photographiés. Clique pour l’autoriser dans Réglages Système."
          }
        }
      }
    },
    "Allow the camera for intruder photos…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser la caméra pour photographier les intrus…"
          }
        }
      }
    },
    "Out of reach" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors de portée"
          }
        }
      }
    },
    "Wallpaper" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fond d’écran"
          }
        }
      }
    },
    "Optional: your wallpaper is in a protected folder. Locky shows it on your iPhone and in its animations." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif : ton fond d’écran est dans un dossier protégé. Locky l’affiche sur ton iPhone et dans ses animations."
          }
        }
      }
    },
    "Show my wallpaper on my iPhone…" : {
      "localizations" : {
        "fr" : {
