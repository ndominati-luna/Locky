        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrement de « %@ »"
          }
        }
      }
    },
    "Leave your iPhone next to your Mac. Locky neither locks nor unlocks meanwhile." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse ton iPhone à côté de ton Mac. Locky ne verrouille ni ne déverrouille pendant ce temps."
          }
        }
      }
    },
